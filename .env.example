# Salin ke .env dan sesuaikan. .env TIDAK di-commit.
# Buat rahasia acak:  openssl rand -base64 32
#
# Ada DUA konteks; file .env di tiap mesin berbeda:
#  (A) DEV lokal (laptop, tanpa Docker) — SQLite.
#  (B) PRODUKSI (VPS, docker compose) — PostgreSQL. Lihat DEPLOY.md.

# ================= (A) DEV lokal — SQLite =================
# Aktifkan baris ini di mesin dev; abaikan blok Postgres di bawah.
DATABASE_URL="file:./prisma/data/dev.db"

# ============== (B) PRODUKSI — PostgreSQL (compose) ==============
# Untuk deploy: KOMENTARI baris SQLite di atas, lalu aktifkan & isi blok ini.
# Host "db" = nama service PostgreSQL di docker-compose.yml.
# POSTGRES_USER=angkasara
# POSTGRES_PASSWORD=ganti-sandi-db-yang-kuat
# POSTGRES_DB=angkasara
# DATABASE_URL="postgresql://angkasara:ganti-sandi-db-yang-kuat@db:5432/angkasara?schema=public"
# APP_PORT=3000                       # port host → app (default 3000)

# ================= Rahasia (WAJIB di kedua konteks) =================
# Better Auth — WAJIB diganti dengan string acak panjang (>=32) di produksi.
BETTER_AUTH_SECRET="ganti-dengan-string-acak-min-32-karakter"
# URL publik aplikasi (untuk Better Auth). Produksi: domain/HTTPS kamu.
BETTER_AUTH_URL="http://localhost:3000"

# Rahasia tanda-tangan cookie sesi siswa (NISN). Beda nilai dari di atas.
STUDENT_SESSION_SECRET="ganti-dengan-string-acak-min-32-karakter"

# ================= Admin awal (saat seeding) =================
# DEV: `npm run seed:admin`.  PRODUKSI: `docker compose run --rm seed`.
# GANTI password sebelum produksi.
ADMIN_EMAIL="admin@smkn1badegan.sch.id"
ADMIN_PASSWORD="admin-angkasara-2026"
ADMIN_NAME="Administrator"
